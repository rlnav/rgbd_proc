<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="false" />

  <!-- Decompress LEFT image -->
  <node pkg="image_transport" exec="republish" name="uncompress_left" output="screen">
    <param name="in_transport" value="compressed" />
    <param name="out_transport" value="raw" />
    <remap from="in/compressed" to="/stereo_camera/left/image_raw_throttle/compressed" />
    <remap from="out" to="/stereo_camera/left/image_raw" />
  </node>

  <!-- Decompress RIGHT image -->
  <node pkg="image_transport" exec="republish" name="uncompress_right" output="screen">
    <param name="in_transport" value="compressed" />
    <param name="out_transport" value="raw" />
    <remap from="in/compressed" to="/stereo_camera/right/image_raw_throttle/compressed" />
    <remap from="out" to="/stereo_camera/right/image_raw" />
  </node>
</launch>